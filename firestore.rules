rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // El email se guarda en minúsculas como id de `allowedEmails`.
    function email() {
      return request.auth.token.email.lower();
    }

    // Usuario con sesión, email verificado y presente en la lista de acceso.
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowedEmails/$(email()));
    }

    function isOwner(uid) {
      return isAllowed() && request.auth.uid == uid;
    }

    function isValidProfile(data) {
      return data.keys().hasOnly(['displayName', 'photoURL', 'units', 'theme'])
        && data.displayName is string
        && (data.photoURL == null || data.photoURL is string)
        && data.units in ['mm', 'in']
        && data.theme in ['dark', 'light', 'system'];
    }

    // Lista de acceso: se administra a mano desde la consola. Cada usuario solo puede
    // consultar su propio email (exista o no) y nadie puede escribirla desde el cliente.
    match /allowedEmails/{allowedEmail} {
      allow get: if request.auth != null && email() == allowedEmail;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfile(request.resource.data);
      allow delete: if false;

      // Inventario, sesiones y demás datos del usuario. `{subcollection}` evita que el
      // comodín recursivo (que acepta cero segmentos) también matchee el perfil.
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
