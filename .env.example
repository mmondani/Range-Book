# Configuración de la app web de Firebase (Consola → Configuración del proyecto → Tus apps).
# Vite carga `.env.development.local` con `pnpm dev` y `.env.production.local` con `pnpm build`.
# Ambos están en .gitignore.
#
# `.env.development.local` (emuladores locales, `pnpm emulators`):
#   VITE_FIREBASE_PROJECT_ID=demo-rangebook
#   VITE_USE_EMULATORS=true
#
# `.env.production.local` (proyecto real):
VITE_FIREBASE_API_KEY=
# Usar el dominio de Hosting (<id>.web.app), no <id>.firebaseapp.com: el login por redirect
# en la PWA de iOS necesita que sea el mismo dominio que sirve la app.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false
