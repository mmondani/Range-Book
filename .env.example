# Configuración de la app web de Firebase (Consola → Configuración del proyecto → Tus apps).
# Copiar a `.env.local` y completar. En desarrollo se usan los emuladores.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-rangebook
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# `true` conecta la app a los emuladores locales (`pnpm emulators`).
VITE_USE_EMULATORS=true
